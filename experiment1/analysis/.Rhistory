percent = round(overall * 100, 2),
n_trials = n(),
n_subj = n_distinct(subject)
)
print(overall_acc)
# Inferential test
logistic_mod <- glmer(
outcome ~ context * interference + (1 | subject),
data = combinedData_sub,
family = binomial
)
summary(logistic_mod)
}
