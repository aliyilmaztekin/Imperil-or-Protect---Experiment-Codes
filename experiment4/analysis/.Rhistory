# abline(h = 0.8, col = "red")
split_half_interaction_once <- function(data) {
data_rand <- data %>%
group_by(subject, repetition, context) %>%
mutate(half = sample(rep(c("A", "B"), length.out = n()))) %>%
ungroup()
means_wide <- data_rand %>%
group_by(subject, repetition, context, half) %>%
summarize(mean_outcome = mean(outcome, na.rm = TRUE), .groups = "drop") %>%
mutate(
repetition = paste0("R", as.character(repetition)),
context = case_when(
context %in% c(0, "0", "nochange", "no_change", "NoChange", "no change", "No Change") ~ "nochange",
context %in% c(1, "1", "change", "Change", "changed") ~ "change",
TRUE ~ as.character(context)
),
cell = paste(half, repetition, context, sep = "_")
) %>%
select(subject, cell, mean_outcome) %>%
tidyr::pivot_wider(names_from = cell, values_from = mean_outcome)
means_wide <- means_wide %>%
mutate(
interaction_A = (A_R5_nochange - A_R1_nochange) -
(A_R5_change   - A_R1_change),
interaction_B = (B_R5_nochange - B_R1_nochange) -
(B_R5_change   - B_R1_change)
)
cor(
means_wide$interaction_A,
means_wide$interaction_B,
use = "complete.obs"
)
}
set.seed(123)
r_vals <- replicate(1000, split_half_interaction_once(data_split))
mean_r <- mean(r_vals, na.rm = TRUE)
rel_corrected <- (2 * mean_r) / (1 + mean_r)
mean_r
rel_corrected
compute_interaction_reliability_k <- function(data, k) {
data_k <- data %>%
group_by(subject, repetition, context) %>%
slice_sample(n = k, replace = FALSE) %>%
ungroup()
r_vals <- replicate(200, split_half_interaction_once(data_k))
mean_r <- mean(r_vals, na.rm = TRUE)
rel <- (2 * mean_r) / (1 + mean_r)
return(rel)
}
k_vals <- seq(10, 80, by = 10)
rel_curve <- sapply(k_vals, function(k)
compute_interaction_reliability_k(data_split, k)
)
plot(k_vals, rel_curve, type = "b")
abline(h = 0.8, col = "red")
